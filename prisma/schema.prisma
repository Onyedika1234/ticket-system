generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password String
  name      String
  department Department
  programme Programme
  role Role    @default(USER)
  paymentStatus paymentStatus @default(OWING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Department {
  SCIENCE
  ARTS
  COMMERCE
}
  
enum Role {
  ADMIN
  USER
}

enum Programme {
  WAEC
  NECO
  GCE
  UTME
  POST_UTME
  JUPEB
}

enum paymentStatus {
  OWING
  PAID
}